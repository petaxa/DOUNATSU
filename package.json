{
  "name": "dounatsu",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.32.1",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc -b && vp build",
    "preview": "vp preview",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "vp run electron:compile && cross-env NODE_ENV=development electron dist/electron/main.js",
    "electron:dist": "vp run build && vp run electron:compile",
    "electron:build-win": "vp run electron:dist && electron-builder --win --publish never",
    "electron:build-mac": "vp run electron:dist && electron-builder --mac --publish never",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  },
  "dependencies": {
    "@formkit/tempo": "^1.1.0",
    "@primeuix/themes": "^2.0.3",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.3",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.34",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.5.5",
    "@types/node": "^25.6.2",
    "@vitejs/plugin-vue": "^6.0.6",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^32.0.0",
    "vite": "^8.0.11",
    "vite-plus": "^0.1.20",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.2.8"
  }
}
